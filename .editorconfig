# EditorConfig — https://editorconfig.org
# Keeps indentation and line endings consistent no matter which editor a
# contributor uses. JARVIS is a Windows-first desktop app, so the Python files
# are normalised to LF in git (see .gitattributes) and checked out the way the
# platform expects.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,html,css,js}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4
