# JARVIS local environment. Copy to `.env` (same folder) and fill in what you use.
# `.env` is git-ignored and loaded at startup by jarvis/core/local_env.py.
# Real environment variables always win over values in this file.
# Never commit real keys. If one ever lands in Git, ROTATE it — deleting the
# file afterwards does not remove it from history.

# --- AI providers ------------------------------------------------------------
# Environment values take precedence over config/api_keys.json.
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # accepted as an alias for GEMINI_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Phone calls (plugins/phone_call.py) --------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# --- Web UI bridge / remote access ---------------------------------------------
JARVIS_WEB_API_KEY=
JARVIS_REMOTE_URL=

# --- Google account plugins (Gmail / Calendar / Drive) --------------------------
# Optional custom location for the OAuth token (written owner-only, 0600).
# JARVIS_GOOGLE_TOKEN_FILE=

# --- Privacy --------------------------------------------------------------------
# OFFLINE=1 blocks every non-local DNS lookup and connection (see NETWORK.md).
# Cloud voice (Gemini Live), web search, news, weather etc. stop working while on.
OFFLINE=0
# With OFFLINE=1, LAN devices (tablet, phone, smart plugs) stay reachable unless
# this is set to 0.
JARVIS_OFFLINE_LAN=1
