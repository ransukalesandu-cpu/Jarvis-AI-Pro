# Python build output
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Secrets and configuration
config/api_keys.json
config/secrets.json
.env
.venv/
venv/

# Biometric vault, credentials, received files, and databases
*.emb
*.emb.npy
*.vault
*.hash
*.db
*.sqlite
*.sqlite3
Jarvis_Received_Files/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Runtime logs and per-user auth material must not be committed
logs/
config/pin_vault.dat
config/auth_state.json
master_voice.emb*
*.emb.npy

# JARVIS per-user credentials and runtime state (never commit these)
JarvisAI/config/pin_vault.dat
JarvisAI/config/auth_state.json
JarvisAI/config/auth_state.json.tmp
JarvisAI/config/voice_id.dat
JarvisAI/config/voice_id.tmp
JarvisAI/logs/
# Autonomous task state (snapshots, journals, queue) is per-machine runtime data
JarvisAI/memory/agent/
logs/
master_voice.emb*
Jarvis_Received_Files/

# Tool caches and reports produced by the dev workflow
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
