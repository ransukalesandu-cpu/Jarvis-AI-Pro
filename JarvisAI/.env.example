# Copy to .env locally; never commit real credentials.
# Supabase public project configuration (public anon/publishable key only).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set this locally only for the first host-device enrollment, using the same
# one-time value configured as the Supabase Edge Function secret. Remove it
# from the local environment after successful enrollment.
JARVIS_HOST_ENROLLMENT_TOKEN=

# Local provider/device settings can be added here; do not put provider API keys
# in source control. Cloud provider keys belong in Supabase Edge Function secrets.
