# Copy to .env locally; never commit real credentials.
# Supabase public project configuration (the anon/publishable key is public).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only needed for first host-device enrollment. Configure the matching value
# as a Supabase Edge Function secret, then remove it from the local environment.
JARVIS_HOST_ENROLLMENT_TOKEN=

# Provider API keys belong in Supabase Edge Function secrets, not this file.
# Optional local offline model settings:
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
