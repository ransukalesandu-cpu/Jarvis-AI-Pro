/* Generated by frontend/scripts/build-tokens.mjs from frontend/tokens/core.json. Do not edit. Theme: hc. */
/* Base Qt theme from the shared tokens. Widgets keep object names; per-widget rules live in jarvis/ui. */
QWidget {
  color: #ffffff;
  font-size: 14px;
  selection-background-color: #66c2ff;
  selection-color: #000000;
}
QMainWindow, QDialog, QWidget#Root {
  background: #000000;
}
QFrame#Glass, QWidget#Glass {
  background: rgba(0, 0, 0, 250);
  border: 1px solid rgba(255, 255, 255, 191);
  border-radius: 12px;
}
QLabel[role="dim"] {
  color: #e6eefb;
}
QLabel[role="faint"] {
  color: #c9d6ea;
  font-size: 12px;
}
QPushButton {
  background: rgba(0, 0, 0, 240);
  border: 1px solid rgba(255, 255, 255, 191);
  border-radius: 8px;
  padding: 8px 16px;
}
QPushButton:hover {
  border-color: #66c2ff;
}
QPushButton:pressed {
  background: rgba(0, 0, 0, 250);
}
QPushButton:focus {
  border: 2px solid #a8dcff;
}
QPushButton:disabled {
  color: #c9d6ea;
  border-color: rgba(255, 255, 255, 191);
}
QPushButton[variant="primary"] {
  background: #66c2ff;
  color: #000000;
  border-color: #66c2ff;
}
QPushButton[tone="danger"] {
  border-color: #ff7a6e;
  color: #ff7a6e;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
  background: rgba(0, 0, 0, 250);
  border: 1px solid rgba(255, 255, 255, 191);
  border-radius: 8px;
  padding: 4px 8px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
  border: 2px solid #a8dcff;
}
QLineEdit[invalid="true"] {
  border-color: #ff7a6e;
}
QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid rgba(255, 255, 255, 191);
  border-radius: 3px;
  background: rgba(0, 0, 0, 240);
}
QCheckBox::indicator:checked {
  background: #66c2ff;
  border-color: #66c2ff;
}
QTabBar::tab {
  padding: 8px 12px;
  color: #e6eefb;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
  color: #ffffff;
  border-bottom-color: #66c2ff;
}
QToolTip {
  background: rgba(0, 0, 0, 250);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 191);
  border-radius: 8px;
  padding: 4px 8px;
}
QScrollBar:vertical {
  width: 8px;
  background: transparent;
}
QScrollBar::handle:vertical {
  background: rgba(255, 255, 255, 191);
  border-radius: 3px;
  min-height: 32px;
}
QScrollBar::add-line, QScrollBar::sub-line {
  height: 0;
}
