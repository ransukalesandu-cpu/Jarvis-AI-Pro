/* Generated by frontend/scripts/build-tokens.mjs from frontend/tokens/core.json. Do not edit. Theme: light. */
/* Base Qt theme from the shared tokens. Widgets keep object names; per-widget rules live in jarvis/ui. */
QWidget {
  color: #0b1726;
  font-size: 14px;
  selection-background-color: #0a64c2;
  selection-color: #eef3f9;
}
QMainWindow, QDialog, QWidget#Root {
  background: #eef3f9;
}
QFrame#Glass, QWidget#Glass {
  background: rgba(255, 255, 255, 230);
  border: 1px solid rgba(30, 80, 140, 61);
  border-radius: 12px;
}
QLabel[role="dim"] {
  color: #33496a;
}
QLabel[role="faint"] {
  color: #4c6280;
  font-size: 12px;
}
QPushButton {
  background: rgba(255, 255, 255, 184);
  border: 1px solid rgba(30, 80, 140, 61);
  border-radius: 8px;
  padding: 8px 16px;
}
QPushButton:hover {
  border-color: #0a64c2;
}
QPushButton:pressed {
  background: rgba(255, 255, 255, 230);
}
QPushButton:focus {
  border: 2px solid #0b56a3;
}
QPushButton:disabled {
  color: #4c6280;
  border-color: rgba(30, 80, 140, 61);
}
QPushButton[variant="primary"] {
  background: #0a64c2;
  color: #eef3f9;
  border-color: #0a64c2;
}
QPushButton[tone="danger"] {
  border-color: #bf2417;
  color: #bf2417;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
  background: rgba(255, 255, 255, 230);
  border: 1px solid rgba(30, 80, 140, 61);
  border-radius: 8px;
  padding: 4px 8px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
  border: 2px solid #0b56a3;
}
QLineEdit[invalid="true"] {
  border-color: #bf2417;
}
QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid rgba(30, 80, 140, 61);
  border-radius: 3px;
  background: rgba(255, 255, 255, 184);
}
QCheckBox::indicator:checked {
  background: #0a64c2;
  border-color: #0a64c2;
}
QTabBar::tab {
  padding: 8px 12px;
  color: #33496a;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
  color: #0b1726;
  border-bottom-color: #0a64c2;
}
QToolTip {
  background: rgba(255, 255, 255, 230);
  color: #0b1726;
  border: 1px solid rgba(30, 80, 140, 61);
  border-radius: 8px;
  padding: 4px 8px;
}
QScrollBar:vertical {
  width: 8px;
  background: transparent;
}
QScrollBar::handle:vertical {
  background: rgba(30, 80, 140, 61);
  border-radius: 3px;
  min-height: 32px;
}
QScrollBar::add-line, QScrollBar::sub-line {
  height: 0;
}
