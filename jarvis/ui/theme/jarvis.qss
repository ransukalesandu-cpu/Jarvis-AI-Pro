/* Generated by frontend/scripts/build-tokens.mjs from frontend/tokens/core.json. Do not edit. Theme: dark. */
/* Base Qt theme from the shared tokens. Widgets keep object names; per-widget rules live in jarvis/ui. */
QWidget {
  color: #dbeaff;
  font-size: 14px;
  selection-background-color: #2f9bff;
  selection-color: #05080d;
}
QMainWindow, QDialog, QWidget#Root {
  background: #05080d;
}
QFrame#Glass, QWidget#Glass {
  background: rgba(14, 24, 40, 199);
  border: 1px solid rgba(120, 190, 255, 56);
  border-radius: 12px;
}
QLabel[role="dim"] {
  color: #8aa4c4;
}
QLabel[role="faint"] {
  color: #7690b0;
  font-size: 12px;
}
QPushButton {
  background: rgba(14, 24, 40, 140);
  border: 1px solid rgba(120, 190, 255, 56);
  border-radius: 8px;
  padding: 8px 16px;
}
QPushButton:hover {
  border-color: #2f9bff;
}
QPushButton:pressed {
  background: rgba(14, 24, 40, 199);
}
QPushButton:focus {
  border: 2px solid #8fd0ff;
}
QPushButton:disabled {
  color: #7690b0;
  border-color: rgba(120, 190, 255, 56);
}
QPushButton[variant="primary"] {
  background: #2f9bff;
  color: #05080d;
  border-color: #2f9bff;
}
QPushButton[tone="danger"] {
  border-color: #ff5a4a;
  color: #ff5a4a;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
  background: rgba(14, 24, 40, 199);
  border: 1px solid rgba(120, 190, 255, 56);
  border-radius: 8px;
  padding: 4px 8px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
  border: 2px solid #8fd0ff;
}
QLineEdit[invalid="true"] {
  border-color: #ff5a4a;
}
QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid rgba(120, 190, 255, 56);
  border-radius: 3px;
  background: rgba(14, 24, 40, 140);
}
QCheckBox::indicator:checked {
  background: #2f9bff;
  border-color: #2f9bff;
}
QTabBar::tab {
  padding: 8px 12px;
  color: #8aa4c4;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
  color: #dbeaff;
  border-bottom-color: #2f9bff;
}
QToolTip {
  background: rgba(14, 24, 40, 199);
  color: #dbeaff;
  border: 1px solid rgba(120, 190, 255, 56);
  border-radius: 8px;
  padding: 4px 8px;
}
QScrollBar:vertical {
  width: 8px;
  background: transparent;
}
QScrollBar::handle:vertical {
  background: rgba(120, 190, 255, 56);
  border-radius: 3px;
  min-height: 32px;
}
QScrollBar::add-line, QScrollBar::sub-line {
  height: 0;
}
